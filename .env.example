# Server Configuration
PORT=5000
NODE_ENV=development

# Database Configuration
# For Local MongoDB:
# MONGODB_URI=mongodb://localhost:27017/medical-store

# For MongoDB Atlas (Cloud):
# MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/medical-store?retryWrites=true&w=majority

MONGODB_URI=mongodb+srv://medicalstore:PASSWORD@YOUR_CLUSTER.mongodb.net/medical-store?retryWrites=true&w=majority

# JWT Configuration
JWT_SECRET=your_jwt_secret_key_change_in_production
JWT_EXPIRE=7d

# CORS Configuration
FRONTEND_URL=http://localhost:3000

# File Upload
MAX_FILE_SIZE=50
UPLOAD_DIR=uploads/

# Google Vision API (for OCR)
GOOGLE_VISION_API_KEY=your_google_vision_api_key

# Email Configuration (optional)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_password

# Redis Configuration (optional, for caching)
REDIS_URL=redis://localhost:6379
